from enum import Enum
from typing import Self

class InfoDatasetBase(Enum):
    @property
    def ID(self) -> int: ...
    @property
    def ICON_ID(self) -> int: ...
    @property
    def DEAD_ID(self) -> int: ...
    @property
    def HOTKEY_ID(self) -> int: ...
    @property
    def IS_GAIA_ONLY(self) -> bool: ...
    @classmethod
    def from_id(cls, unit_id: int) -> Self: ...
